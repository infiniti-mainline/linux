/dts-v1/;

#include <dt-bindings/clock/qcom,kaanapali-dispcc.h>
#include <dt-bindings/clock/qcom,kaanapali-gcc.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/regulator/qcom,rpmh-regulator.h>

#include "kaanapali.dtsi"
#include "pmh0104-kaanapali.dtsi"     /* SPMI1: SID-9 (WCN7860 BT_EN on pmh0104_j gpio5) */
#include "pmh0110-kaanapali.dtsi"     /* SPMI0: SID-3/5/6/8 (touch AVDD switch on pmh0110_d gpio9) */
#include "pmih0108-kaanapali.dtsi"    /* SPMI1: SID-7 (eUSB2 repeater) */
#include "pmk8850.dtsi"               /* SPMI0: SID-0 (PON, reboot reason SDAM) */

/ {
    model = "OnePlus 15";
    compatible = "oneplus,infiniti", "qcom,kaanapali";
    chassis-type = "handset";

    /* qcom_geni_serial derives its line number from a serial* alias and
     * fails probe with "Invalid line -19" without one (measured on the
     * first connectivity boot). serial1 matches the MTP, keeping serial0
     * for the uart7 debug UART if it is ever enabled. */
    aliases {
        serial1 = &uart18;
    };

    /* cont_splash_mem stays reserved: the bootloader still scans out of it
     * until the DPU is reprogrammed; freeing it is a later cleanup. */
    reserved-memory {
        cont_splash_mem: memory@fc800000 {
            reg = <0x0 0xfc800000 0x0 0x2b00000>;
            no-map;
        };

        /* Crash forensics across the warm reset: suspend-path failures
         * self-reboot (panic=30, or a NoC-error hard reset) into the
         * stock chain and take dmesg with them. ramoops + ECC preserves
         * the last records in DDR (a warm reset does not scrub it).
         * 0xd7400000 sits in the free window below rmtfs@d7c00000;
         * nothing else reserves it.
         */
        ramoops@d7400000 {
            compatible = "ramoops";
            reg = <0x0 0xd7400000 0x0 0x400000>;
            record-size = <0x40000>;
            console-size = <0x80000>;
            ecc-size = <16>;
        };
    };

    clocks {
        xo_board: xo-board {
            compatible = "fixed-clock";
            clock-frequency = <76800000>;
            #clock-cells = <0>;
        };

        sleep_clk: sleep-clk {
            compatible = "fixed-clock";
            clock-frequency = <32764>;
            #clock-cells = <0>;
        };

        bi_tcxo_div2: bi-tcxo-div2-clk {
            compatible = "fixed-factor-clock";
            #clock-cells = <0>;

            clocks = <&rpmhcc RPMH_CXO_CLK>;
            clock-mult = <1>;
            clock-div = <2>;
        };

        bi_tcxo_ao_div2: bi-tcxo-ao-div2-clk {
            compatible = "fixed-factor-clock";
            #clock-cells = <0>;

            clocks = <&rpmhcc RPMH_CXO_CLK_A>;
            clock-mult = <1>;
            clock-div = <2>;
        };
    };

    /*
     * Touchscreen AVDD comes from a load switch enabled by pmh0110_d
     * gpio9 (downstream infiniti-oplus-tp-24831.dtsi: avdd is a PMIC
     * gpio, not a named LDO). The switched rail's voltage is UNMEASURED
     * (typical panel-touch AVDD is 3.0-3.3 V); modeled as a fixed
     * regulator with only the enable gpio until verified on hardware.
     */
    vreg_ts_avdd: regulator-ts-avdd {
        compatible = "regulator-fixed";
        regulator-name = "vreg_ts_avdd";

        gpio = <&pmh0110_d_e0_gpios 9 GPIO_ACTIVE_HIGH>;
        enable-active-high;
    };

    /*
     * WCN7860 wifi+BT combo. The chip is the WCN7850's successor and no
     * mainline driver knows it by name yet; the PMU node reuses the
     * qcom,wcn7850-pmu power sequencer, whose supply set matches both the
     * Qualcomm kaanapali-mtp.dts WCN785x wiring and the downstream
     * canoe-wcn786x-bt.dtsi rails for this exact board (L2G/L3G/S2J/S1J/
     * S7F/S8F + RF_CLK1; BT_EN pmh0104_j gpio5, WL_EN tlmm 16, SW_CTRL
     * tlmm 18 all byte-match downstream). Supply mapping follows the MTP
     * (same PMIC set); the two boards agree on every rail downstream
     * names.
     */
    wcn7860_pmu: wcn7860-pmu {
        compatible = "qcom,wcn7850-pmu";

        pinctrl-0 = <&bt_default>, <&sw_ctrl_default>, <&wlan_en>;
        pinctrl-names = "default";

        bt-enable-gpios = <&pmh0104_j_e1_gpios 5 GPIO_ACTIVE_HIGH>;
        wlan-enable-gpios = <&tlmm 16 GPIO_ACTIVE_HIGH>;

        vdd-supply = <&pmh0104_s2>;
        vddio-supply = <&pmh0110_g_l2>;
        vddio1p2-supply = <&pmh0110_g_l3>;
        vddaon-supply = <&pmh0110_g_s7>;
        vdddig-supply = <&pmh0104_s1>;
        vddrfa1p2-supply = <&pmh0110_f_s7>;
        vddrfa1p8-supply = <&pmh0110_f_s8>;

        clocks = <&rpmhcc RPMH_RF_CLK1>;

        regulators {
            vreg_pmu_rfa_cmn: ldo0 {
                regulator-name = "vreg_pmu_rfa_cmn";
            };

            vreg_pmu_aon_0p59: ldo1 {
                regulator-name = "vreg_pmu_aon_0p59";
            };

            vreg_pmu_wlcx_0p8: ldo2 {
                regulator-name = "vreg_pmu_wlcx_0p8";
            };

            vreg_pmu_wlmx_0p85: ldo3 {
                regulator-name = "vreg_pmu_wlmx_0p85";
            };

            vreg_pmu_btcmx_0p85: ldo4 {
                regulator-name = "vreg_pmu_btcmx_0p85";
            };

            vreg_pmu_rfa_0p8: ldo5 {
                regulator-name = "vreg_pmu_rfa_0p8";
            };

            vreg_pmu_rfa_1p2: ldo6 {
                regulator-name = "vreg_pmu_rfa_1p2";
            };

            vreg_pmu_rfa_1p8: ldo7 {
                regulator-name = "vreg_pmu_rfa_1p8";
            };

            vreg_pmu_pcie_0p9: ldo8 {
                regulator-name = "vreg_pmu_pcie_0p9";
            };

            vreg_pmu_pcie_1p8: ldo9 {
                regulator-name = "vreg_pmu_pcie_1p8";
            };
        };
    };

    pmic-glink {
        compatible = "qcom,kaanapali-pmic-glink",
                     "qcom,pmic-glink";
        #address-cells = <1>;
        #size-cells = <0>;

        connector@0 {
            compatible = "usb-c-connector";
            reg = <0>;

            power-role = "dual";
            data-role = "dual";

            ports {
                #address-cells = <1>;
                #size-cells = <0>;

                port@0 {
                    reg = <0>;

                    pmic_glink_hs_in: endpoint {
                        remote-endpoint = <&usb_dwc3_hs>;
                    };
                };

                port@1 {
                    reg = <1>;

                    pmic_glink_ss_in: endpoint {
                        remote-endpoint = <&usb_dp_qmpphy_out>;
                    };
                };

                port@2 {
                    reg = <2>;

                    pmic_glink_sbu: endpoint {
                    };
                };
            };
        };
    };
};

&apps_rsc {
    regulators-0 {
        compatible = "qcom,pmh0101-rpmh-regulators";
        qcom,pmic-id = "B_E0";

        pmh0101_bob1: bob1 {
            regulator-name = "pmh0101_bob1";
            regulator-min-microvolt = <3008000>;
            regulator-max-microvolt = <4000000>;
            regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
        };

        pmh0101_bob2: bob2 {
            regulator-name = "pmh0101_bob2";
            regulator-min-microvolt = <2704000>;
            regulator-max-microvolt = <3552000>;
            regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
        };

        pmh0101_l1: ldo1 {
            regulator-name = "pmh0101_l1";
            regulator-min-microvolt = <1800000>;
            regulator-max-microvolt = <1800000>;

            regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
            regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM RPMH_REGULATOR_MODE_AUTO>;

            regulator-allow-set-load;
        };

        pmh0101_l2: ldo2 {
            regulator-name = "pmh0101_l2";
            regulator-min-microvolt = <3008000>;
            regulator-max-microvolt = <3048000>;

            regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
            regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM RPMH_REGULATOR_MODE_AUTO>;

            regulator-allow-set-load;
        };

        pmh0101_l4: ldo4 {
            regulator-name = "pmh0101_l4";
            regulator-min-microvolt = <1800000>;
            regulator-max-microvolt = <1800000>;

            regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
            regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM RPMH_REGULATOR_MODE_AUTO>;

