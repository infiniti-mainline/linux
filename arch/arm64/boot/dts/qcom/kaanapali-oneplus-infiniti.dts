    regulators-4 {
        compatible = "qcom,pmh0110-rpmh-regulators";
        qcom,pmic-id = "I_E0";

        pmh0110_i_s7: smps7 {
            regulator-name = "pmh0110_i_s7";
            regulator-min-microvolt = <900000>;
            regulator-max-microvolt = <972000>;
            regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
        };

        pmh0110_i_l2: ldo2 {
            regulator-name = "pmh0110_i_l2";
            regulator-min-microvolt = <1200000>;
            regulator-max-microvolt = <1200000>;

            regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
            regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM RPMH_REGULATOR_MODE_AUTO>;

            regulator-allow-set-load;
        };

        pmh0110_i_l3: ldo3 {
            regulator-name = "pmh0110_i_l3";
            regulator-min-microvolt = <880000>;
            regulator-max-microvolt = <920000>;

            regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
            regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM RPMH_REGULATOR_MODE_AUTO>;

            regulator-allow-set-load;
        };

        pmh0110_i_l4: ldo4 {
            regulator-name = "pmh0110_i_l4";
            regulator-min-microvolt = <800000>;
            regulator-max-microvolt = <800000>;

            regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
            regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM RPMH_REGULATOR_MODE_AUTO>;

            regulator-allow-set-load;
        };
    };

    regulators-5 {
        compatible = "qcom,pmh0104-rpmh-regulators";
        qcom,pmic-id = "J_E1";

        pmh0104_s1: smps1 {
            regulator-name = "pmh0104_s1";
            regulator-min-microvolt = <400000>;
            regulator-max-microvolt = <1000000>;
            regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
        };

        pmh0104_s2: smps2 {
            regulator-name = "pmh0104_s2";
            regulator-min-microvolt = <500000>;
            regulator-max-microvolt = <1100000>;
            regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
        };

        pmh0104_s3: smps3 {
            regulator-name = "pmh0104_s3";
            regulator-min-microvolt = <1200000>;
            regulator-max-microvolt = <1300000>;
            regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
        };

        pmh0104_s4: smps4 {
            regulator-name = "pmh0104_s4";
            regulator-min-microvolt = <300000>;
            regulator-max-microvolt = <1000000>;
            regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
        };
    };

    regulators-6 {
        compatible = "qcom,pmr735d-rpmh-regulators";
        qcom,pmic-id = "K_E1";

        pmr735d_l1: ldo1 {
            regulator-name = "pmr735d_l1";
            regulator-min-microvolt = <300000>;
            regulator-max-microvolt = <1100000>;

            regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
            regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM RPMH_REGULATOR_MODE_HPM>;

            regulator-allow-set-load;
        };

        pmr735d_l2: ldo2 {
            regulator-name = "pmr735d_l2";
            regulator-min-microvolt = <700000>;
            regulator-max-microvolt = <1000000>;

            regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
            regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM RPMH_REGULATOR_MODE_HPM>;

            regulator-allow-set-load;
        };

        pmr735d_l3: ldo3 {
            regulator-name = "pmr735d_l3";
            regulator-min-microvolt = <1200000>;
            regulator-max-microvolt = <1200000>;

            regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
            regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM RPMH_REGULATOR_MODE_HPM>;

            regulator-allow-set-load;
        };

        pmr735d_l4: ldo4 {
            regulator-name = "pmr735d_l4";
            regulator-min-microvolt = <1000000>;
            regulator-max-microvolt = <1200000>;

            regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
            regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM RPMH_REGULATOR_MODE_HPM>;

            regulator-allow-set-load;
        };

        pmr735d_l5: ldo5 {
            regulator-name = "pmr735d_l5";
            regulator-min-microvolt = <700000>;
            regulator-max-microvolt = <1000000>;

            regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
            regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM RPMH_REGULATOR_MODE_HPM>;

            regulator-allow-set-load;
        };

        pmr735d_l6: ldo6 {
            regulator-name = "pmr735d_l6";
            regulator-min-microvolt = <1700000>;
            regulator-max-microvolt = <2000000>;

            regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
            regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM RPMH_REGULATOR_MODE_HPM>;

            regulator-allow-set-load;
        };

        pmr735d_l7: ldo7 {
            regulator-name = "pmr735d_l7";
            regulator-min-microvolt = <700000>;
            regulator-max-microvolt = <848000>;

            regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
            regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM RPMH_REGULATOR_MODE_HPM>;

            regulator-allow-set-load;
        };
    };

    regulators-7 {
        compatible = "qcom,pm8010-rpmh-regulators";
        qcom,pmic-id = "M_E1";

        pm8010_m_l1: ldo1 {
            regulator-name = "pm8010_m_l1";
            regulator-min-microvolt = <1000000>;
            regulator-max-microvolt = <1100000>;

            regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
            regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM RPMH_REGULATOR_MODE_HPM>;

            regulator-allow-set-load;
        };

        pm8010_m_l2: ldo2 {
            regulator-name = "pm8010_m_l2";
            regulator-min-microvolt = <1100000>;
            regulator-max-microvolt = <1200000>;

            regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
            regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM RPMH_REGULATOR_MODE_HPM>;

            regulator-allow-set-load;
        };

        pm8010_m_l3: ldo3 {
            regulator-name = "pm8010_m_l3";
            regulator-min-microvolt = <2800000>;
            regulator-max-microvolt = <2900000>;
            regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
        };

        pm8010_m_l4: ldo4 {
            regulator-name = "pm8010_m_l4";
            regulator-min-microvolt = <2800000>;
            regulator-max-microvolt = <2800000>;
            regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
        };

        pm8010_m_l5: ldo5 {
            regulator-name = "pm8010_m_l5";
            regulator-min-microvolt = <1200000>;
            regulator-max-microvolt = <1800000>;
            regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
        };

        pm8010_m_l6: ldo6 {
            regulator-name = "pm8010_m_l6";
            regulator-min-microvolt = <2200000>;
            regulator-max-microvolt = <2200000>;
