        };
    };

    regulators-2 {
        compatible = "qcom,pmh0110-rpmh-regulators";
        qcom,pmic-id = "F_E0";

        pmh0110_f_s6: smps6 {
            regulator-name = "pmh0110_f_s6";
            regulator-min-microvolt = <300000>;
            regulator-max-microvolt = <570000>;
            regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
        };

        pmh0110_f_s7: smps7 {
