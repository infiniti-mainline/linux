        };

        pmh0101_l5: ldo5 {
            regulator-name = "pmh0101_l5";
            regulator-min-microvolt = <3100000>;
            regulator-max-microvolt = <3148000>;

            regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
            regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM RPMH_REGULATOR_MODE_AUTO>;

            regulator-allow-set-load;
        };

        pmh0101_l6: ldo6 {
            regulator-name = "pmh0101_l6";
            regulator-min-microvolt = <1800000>;
            regulator-max-microvolt = <3008000>;

            regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
            regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM RPMH_REGULATOR_MODE_AUTO>;

            regulator-allow-set-load;
        };

        pmh0101_l7: ldo7 {
            regulator-name = "pmh0101_l7";
            regulator-min-microvolt = <1800000>;
            regulator-max-microvolt = <3008000>;

            regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
            regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM RPMH_REGULATOR_MODE_AUTO>;

            regulator-allow-set-load;
        };

        pmh0101_l8: ldo8 {
            regulator-name = "pmh0101_l8";
            regulator-min-microvolt = <1800000>;
            regulator-max-microvolt = <3008000>;

            regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
            regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM RPMH_REGULATOR_MODE_AUTO>;

            regulator-allow-set-load;
        };

        pmh0101_l9: ldo9 {
            regulator-name = "pmh0101_l9";
            regulator-min-microvolt = <3200000>;
            regulator-max-microvolt = <3200000>;

            regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
            regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM RPMH_REGULATOR_MODE_HPM>;

            regulator-allow-set-load;
        };

        pmh0101_l10: ldo10 {
            regulator-name = "pmh0101_l10";
            regulator-min-microvolt = <1800000>;
            regulator-max-microvolt = <1800000>;

            regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
            regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM RPMH_REGULATOR_MODE_AUTO>;

            regulator-allow-set-load;
        };

        pmh0101_l11: ldo11 {
            regulator-name = "pmh0101_l11";
            regulator-min-microvolt = <1200000>;
            regulator-max-microvolt = <1200000>;

            regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
            regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM RPMH_REGULATOR_MODE_AUTO>;

            regulator-allow-set-load;
        };

        pmh0101_l12: ldo12 {
            regulator-name = "pmh0101_l12";
            /* panel vddio: sole consumer is mdss_dsi0 panel@0 vddio-supply.
             * downstream + Qualcomm MTP (kaanapali-mtp vreg_l12b_1p8) run this
             * at 1.8 V; the 1.2 V floor left the DDIC IO ring underpowered
             * (regulator_summary showed 1.2 V), so pin it at 1.8 V. */
            regulator-min-microvolt = <1800000>;
            regulator-max-microvolt = <1800000>;

            regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
            regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM RPMH_REGULATOR_MODE_AUTO>;

            regulator-allow-set-load;
        };

        pmh0101_l13: ldo13 {
            regulator-name = "pmh0101_l13";
            regulator-min-microvolt = <3000000>;
            regulator-max-microvolt = <3000000>;

            regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
            regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM RPMH_REGULATOR_MODE_AUTO>;

            regulator-allow-set-load;
        };

        pmh0101_l14: ldo14 {
            regulator-name = "pmh0101_l14";
            regulator-min-microvolt = <3200000>;
            regulator-max-microvolt = <3200000>;

            regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
            regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM RPMH_REGULATOR_MODE_AUTO>;

            regulator-allow-set-load;
        };

        pmh0101_l15: ldo15 {
            regulator-name = "pmh0101_l15";
            regulator-min-microvolt = <1800000>;
            regulator-max-microvolt = <1800000>;

            regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
            regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM RPMH_REGULATOR_MODE_AUTO>;

            regulator-allow-set-load;
        };

        pmh0101_l16: ldo16 {
            regulator-name = "pmh0101_l16";
            regulator-min-microvolt = <3300000>;
            regulator-max-microvolt = <3300000>;

            regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
            regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM RPMH_REGULATOR_MODE_AUTO>;

            regulator-allow-set-load;
        };

        pmh0101_l17: ldo17 {
            regulator-name = "pmh0101_l17";
            regulator-min-microvolt = <2504000>;
            regulator-max-microvolt = <2504000>;

            regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
            regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM RPMH_REGULATOR_MODE_HPM>;

